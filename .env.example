# Copy to .env.runpod and fill in — NEVER commit the real file
SGLANG_API_KEY=<generate: openssl rand -hex 24>
VOL_ID=<runpodctl network-volume list>
HF_TOKEN=<huggingface.co/settings/tokens>
POD_ID=<current pod>

# profiles: ./pod.sh rebuild [5090|6000]
TPL_5090=<llama.cpp template id>
GPU_5090="NVIDIA GeForce RTX 5090"
TPL_6000=<sglang template id>
GPU_6000="NVIDIA RTX PRO 6000 Blackwell Server Edition"
